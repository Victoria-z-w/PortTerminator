<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PortTerminator.UI</RootNamespace>
    <AssemblyName>PortTerminator.UI</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app-logo.png" />
    <Resource Include="Assets\app-icon.png" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PortTerminator.Core\PortTerminator.Core.csproj" />
    <ProjectReference Include="..\PortTerminator.Windows\PortTerminator.Windows.csproj" />
    <ProjectReference Include="..\PortTerminator.Infrastructure\PortTerminator.Infrastructure.csproj" />
    <ProjectReference Include="..\PortTerminator.Elevated\PortTerminator.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>
  <Target Name="CopyElevatedHelper" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_ElevatedSourcePath Condition="'$(RuntimeIdentifier)' == ''">..\PortTerminator.Elevated\bin\$(Configuration)\net8.0-windows\PortTerminator.Elevated.exe</_ElevatedSourcePath>
      <_ElevatedSourcePath Condition="'$(RuntimeIdentifier)' != ''">..\PortTerminator.Elevated\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\PortTerminator.Elevated.exe</_ElevatedSourcePath>
      <_ElevatedDestDir Condition="'$(PublishDir)' != '' and '$(PublishDir)' != '*Undefined*'">$(PublishDir)</_ElevatedDestDir>
      <_ElevatedDestDir Condition="'$(_ElevatedDestDir)' == ''">$(OutDir)</_ElevatedDestDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_ElevatedSourcePath)"
          DestinationFolder="$(_ElevatedDestDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_ElevatedSourcePath)')" />
  </Target>
</Project>
