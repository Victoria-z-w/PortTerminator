<Application x:Class="PortTerminator.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PortTerminator.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:RiskLevelToBrushConverter x:Key="RiskBrush"/>
            <conv:LogLevelToBrushConverter x:Key="LogBrush"/>
            <conv:LogLevelToTextConverter x:Key="LogText"/>
            <conv:NavigationPageToVisibilityConverter x:Key="PageVis"/>
            <conv:NavigationPageToNavStyleConverter x:Key="NavStyle"/>
            <conv:NavPageMatchConverter x:Key="NavMatch"/>
            <conv:HighRiskForegroundConverter x:Key="HighRiskFg"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
